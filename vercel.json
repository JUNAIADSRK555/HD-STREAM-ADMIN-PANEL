{
  "version": 2,
  "services": {
    "stream-admin-backend": {
      "root": ".",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "stream-admin-backend"
      }
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

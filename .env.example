# Server Port
PORT=5000

# MongoDB Atlas URI (Free M0 Cluster)
# Example: mongodb+srv://admin:YourPassword123@cluster0.xyz.mongodb.net/streamdb?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:YourPassword123@cluster0.xyz.mongodb.net/streamdb?retryWrites=true&w=majority

# Secret Key for Admin Authentication
ADMIN_API_KEY=jdcric_secure_admin_2026

# Node Environment ('development' or 'production')
NODE_ENV=production

# Public Base URL (Used for generating absolute M3U / JSON feed links)
# Example on Render: https://stream-admin-api.onrender.com
# Example on Vercel: https://stream-admin-api.vercel.app
APP_BASE_URL=https://stream-admin-api.onrender.com

# Google Drive Playlist Auto-Sync URL (Supports direct uc?export=download&id=FILE_ID or /file/d/FILE_ID/view)
GOOGLE_DRIVE_PLAYLIST_URL=https://drive.google.com/uc?export=download&id=YOUR_GOOGLE_DRIVE_FILE_ID
